{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@engora/web"
      ],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "-C",
        "apps/api",
        "./cmd/server"
      ],
      "port": 8000
    }
  ]
}
