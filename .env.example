# =============================================================================
# Engora environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# This single root file is read by docker compose, the Go API (apps/api) and the
# Next.js web app (apps/web). Never commit `.env`.
# =============================================================================

# --- Application --------------------------------------------------------------
APP_ENV=development                # development | test | production
APP_PORT=8000
APP_VERSION=dev
LOG_LEVEL=debug                    # debug | info | warn | error
LOG_FORMAT=text                    # text (human) | json (production)

# --- HTTP ---------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For is trusted.
# Locally the Next.js session route forwards the browser IP from 127.0.0.1. In production
# list only your load balancer / web server addresses, otherwise clients can spoof IPs.
TRUSTED_PROXIES=127.0.0.1,::1
# Requests per minute per client IP on authentication endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- PostgreSQL (source of truth) --------------------------------------------
POSTGRES_USER=engora
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=engora
# Host port for the docker Postgres (5433 avoids clashing with a local Postgres).
POSTGRES_PORT=5433
DATABASE_URL=postgres://engora:change-me-local-only@localhost:5433/engora?sslmode=disable
DATABASE_MAX_CONNS=10

# --- Redis (cache, rate limits, job queue — never permanent data) ------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Authentication -----------------------------------------------------------
# At least 32 random characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=engora
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Google sign-in -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID.
#   Web application: Authorized JavaScript origins = http://localhost:3001 (and your domain).
#   iOS / Android: create one client per app later and append its ID here.
# The API accepts ID tokens issued to any listed client (comma-separated). Client IDs are
# public identifiers, not secrets; no client secret is needed for ID-token sign-in.
GOOGLE_CLIENT_IDS=
# The web client ID from above, used by the browser to render the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- AI -----------------------------------------------------------------------
AI_PROVIDER=mock                   # mock | openai
# The model that writes what learners are taught from: grammar lessons (generated once per
# topic, level and language and then cached), free-text marking, diagrams.
# gpt-4.1-mini is the affordable default; gpt-4.1 writes noticeably better lessons.
AI_MODEL=gpt-4.1-mini
# Short, frequent, per-learner calls — the grammar tutor answering one question.
# Defaults to AI_MODEL when unset.
AI_FAST_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Placement writing/speaking evaluation and speech-to-text use this provider. "mock" runs the whole
# pipeline locally with deterministic, non-linguistic scores — use a real provider for genuine results.

# --- Background jobs ------------------------------------------------------------
# Run a job worker inside the API process (default: true in development, false otherwise).
# Production should run `make worker` / cmd/worker separately.
JOBS_EMBEDDED_WORKER=

# --- Object storage -----------------------------------------------------------
STORAGE_PROVIDER=local             # local | s3  (s3 also covers Cloudflare R2)
STORAGE_LOCAL_DIR=./var/storage
STORAGE_BUCKET=
STORAGE_REGION=auto                # "auto" for Cloudflare R2
# R2: https://<account-id>.r2.cloudflarestorage.com   AWS S3: leave empty
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_MAX_UPLOAD_MB=25

# --- Email ----------------------------------------------------------------------
# smtp | resend | log (development: emails are only printed, codes shown on the verify page) | none
MAIL_PROVIDER=log
# Sender. With Gmail SMTP it must be your Gmail address; with Resend, an address on a verified domain.
MAIL_FROM=Engora <no-reply@engora.local>
# SMTP (any provider). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
# SMTP_PASSWORD=<16-character App Password from myaccount.google.com/apppasswords; requires 2-Step Verification>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Resend (https://resend.com): API key starting with re_
RESEND_API_KEY=
# Brevo (https://brevo.com): HTTPS API, works where SMTP ports are blocked. No domain needed:
# verify MAIL_FROM under Senders & IPs, then create an API key (xkeysib-...) under SMTP & API.
BREVO_API_KEY=
# Public web origin used in links inside emails (password reset).
WEB_APP_URL=http://localhost:3001

# --- Observability ------------------------------------------------------------
ERROR_TRACKER=log                  # log (future: sentry)

# --- Web (Next.js) ------------------------------------------------------------
WEB_PORT=3001
# Public API origin used by the browser (no /api/v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000
# API origin used by Next.js server code (docker: http://api:8000).
API_INTERNAL_URL=http://localhost:8000
