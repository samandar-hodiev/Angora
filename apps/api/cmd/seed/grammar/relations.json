 "comparisons": [
  {
   "left": "past-simple",
   "right": "present-perfect",
   "summary": "Past Simple puts the action in finished time. Present Perfect connects it to now.",
   "rows": [
    {
     "aspect": "Time",
     "left": "Finished, and we know when",
     "right": "Connected to now, or we do not say when"
    },
    {
     "aspect": "Example",
     "left": "I saw him yesterday.",
     "right": "I have seen him."
    },
    {
     "aspect": "Question",
     "left": "When did you see him?",
     "right": "Have you ever seen him?"
    },
    {
     "aspect": "Signal words",
     "left": "yesterday, last year, in 2020, ago",
     "right": "already, ever, never, yet, just, since, for"
    },
    {
     "aspect": "Wrong",
     "left": "I have seen him yesterday.",
     "right": "I saw him already."
    }
   ]
  },
  {
   "left": "past-simple",
   "right": "past-continuous",
   "summary": "Past Simple is the whole action. Past Continuous is the action in progress around it.",
   "rows": [
    {
     "aspect": "View",
     "left": "The complete action",
     "right": "The action in the middle"
    },
    {
     "aspect": "Example",
     "left": "I cooked dinner.",
     "right": "I was cooking dinner."
    },
    {
     "aspect": "Together",
     "left": "The phone rang",
     "right": "while I was cooking."
    },
    {
     "aspect": "Signal words",
     "left": "then, after that, at 8 o'clock",
     "right": "while, as, at 8 o'clock (in progress)"
    }
   ]
  },
  {
   "left": "present-simple",
   "right": "present-continuous",
   "summary": "Present Simple is what is always true. Present Continuous is what is happening around now.",
   "rows": [
    {
     "aspect": "Meaning",
     "left": "Habits, routines, facts",
     "right": "Now, or a temporary period"
    },
    {
     "aspect": "Example",
     "left": "I work in Tashkent.",
     "right": "I am working from home this week."
    },
    {
     "aspect": "Signal words",
     "left": "always, usually, every day",
     "right": "now, at the moment, this week"
    },
    {
     "aspect": "Stative verbs",
     "left": "I know the answer.",
     "right": "NOT: I am knowing the answer."
    }
   ]
  },
  {
   "left": "few-little",
   "right": "a-few-a-little",
   "summary": "Few and little mean not enough. A few and a little mean some — enough to be useful.",
   "rows": [
    {
     "aspect": "Feeling",
     "left": "Negative: not enough",
     "right": "Positive: some"
    },
    {
     "aspect": "Countable",
     "left": "Few people came.",
     "right": "A few people came."
    },
    {
     "aspect": "Uncountable",
     "left": "I have little time.",
     "right": "I have a little time."
    },
    {
     "aspect": "Meaning",
     "left": "Almost nobody / almost nothing",
     "right": "Not many, but some"
    }
   ]
  },
  {
   "left": "much-many",
   "right": "less-fewer",
   "summary": "Much and many go up; less and fewer go down. Both split the same way: uncountable versus countable.",
   "rows": [
    {
     "aspect": "Uncountable",
     "left": "much water",
     "right": "less water"
    },
    {
     "aspect": "Countable",
     "left": "many bottles",
     "right": "fewer bottles"
    },
    {
     "aspect": "Question",
     "left": "How much? How many?",
     "right": "—"
    },
    {
     "aspect": "Common mistake",
     "left": "much bottles",
     "right": "less bottles"
    }
   ]
  },
  {
   "left": "first-conditional",
   "right": "second-conditional",
   "summary": "First Conditional is a real possibility. Second Conditional is imagining something that is not true now.",
   "rows": [
    {
     "aspect": "Situation",
     "left": "Real, possible future",
     "right": "Imaginary or unlikely"
    },
    {
     "aspect": "Form",
     "left": "If + present simple, will + verb",
     "right": "If + past simple, would + verb"
    },
    {
     "aspect": "Example",
     "left": "If it rains, I will stay home.",
     "right": "If I had a car, I would drive."
    },
    {
     "aspect": "Meaning",
     "left": "It might really happen",
     "right": "It is not the case now"
    }
   ]
  },
  {
   "left": "must",
   "right": "have-to",
   "summary": "Must is obligation coming from the speaker. Have to is obligation coming from outside.",
   "rows": [
    {
     "aspect": "Source",
     "left": "The speaker decides",
     "right": "A rule or situation decides"
    },
    {
     "aspect": "Example",
     "left": "I must call my mother.",
     "right": "I have to wear a uniform."
    },
    {
     "aspect": "Negative",
     "left": "You mustn't smoke. (prohibited)",
     "right": "You don't have to come. (not necessary)"
    },
    {
     "aspect": "Past",
     "left": "— (use had to)",
     "right": "I had to leave early."
    }
   ]
  },
  {
   "left": "gerunds",
   "right": "infinitives",
   "summary": "A gerund is a verb used as a noun. An infinitive is to + verb, usually pointing at a purpose or a result.",
   "rows": [
    {
     "aspect": "Form",
     "left": "verb + -ing",
     "right": "to + base verb"
    },
    {
     "aspect": "As subject",
     "left": "Swimming is good for you.",
     "right": "To swim every day takes time."
    },
    {
     "aspect": "After verbs",
     "left": "enjoy, avoid, finish, mind",
     "right": "want, decide, hope, promise"
    },
    {
     "aspect": "After prepositions",
     "left": "good at swimming",
     "right": "— (never after a preposition)"
    }
   ]
  },
  {
   "left": "defining-relative",
   "right": "non-defining-relative",
   "summary": "A defining clause says which one. A non-defining clause adds information you could remove.",
   "rows": [
    {
     "aspect": "Commas",
     "left": "No commas",
     "right": "Always commas"
    },
    {
     "aspect": "Example",
     "left": "The man who lives next door is a doctor.",
     "right": "My father, who lives next door, is a doctor."
    },
    {
     "aspect": "That",
     "left": "Possible: the man that lives...",
     "right": "Never: NOT my father, that lives..."
    },
    {
     "aspect": "Remove it",
